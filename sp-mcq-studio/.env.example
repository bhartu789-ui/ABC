# Set server-side only in Vercel > Project > Settings > Environment Variables
GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional; default is gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Google sign-in (both are required to enable mandatory login)
# Create an OAuth 2.0 Web application client in Google Cloud:
GOOGLE_CLIENT_ID=
# Server-only, cryptographically random string (32+ characters; never commit real key):
SESSION_SECRET=
